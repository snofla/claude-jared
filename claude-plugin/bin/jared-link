#!/bin/sh
# jared-link: make the link that opens a file in Jared, as a protocol "open" request in the link's fragment; or, with --file, open the
# file in the one-file Jared, which is a page opened from a path, with the request in a script beside it; or, with --serve, put the file
# in a review folder that a small service on this computer serves over http, so that a browser tool can show it.
# Uses only sh, perl (JSON::PP, MIME::Base64, IO::Socket::INET, IO::Select and POSIX are in perl's core) and the common tools wc, date, basename
# and tr, for --file and --serve also dirname, mkdir, mktemp, find, ln, cp, rm, kill and sleep, and for --rev git, cut, mkdir, mktemp, find, rm and mv.
# Run it with --help for the options and the exit statuses.

usage() {
  cat <<'USAGE'
Usage: jared-link <file> [--jared <address>] [--open] [--max <bytes>]
       jared-link <file> --file [--page <path>] [--max <bytes>]
       jared-link <file>... --serve [--label <words>] [--closes moment|now|never] [--message <words>] [--banner true|false]
                                    [--review-file] [--port <number>] [--page <path>] [--max <bytes>]
       jared-link --rev <commit> [--max <bytes>]
       jared-link --wait <review> [--after <revision>] [--timeout <seconds>]
       jared-link --check <file>... [--max <bytes>]
       jared-link --stop
       jared-link --status
       jared-link --version

Prints a link that opens <file> in Jared: Jared's address, then #jared=<base64url JSON of an "open" request>.
The fragment never goes to a server, so the file stays between the browser and whoever has the link.
The request also names Claude as the one to tell (submitTarget), which only changes what the dialog says; it asks for no button.

  --jared <address>   where Jared runs (default: $JARED_URL, or http://localhost:5173/)
  --open              open the link in the system's browser (open, or xdg-open) instead of printing it; prints one sentence
  --max <bytes>       the largest file to take (default 524288, which is what Jared opens); with --serve and several files, also
                      the most that all of them are together

  --file              open <file> in the one-file Jared (a page that opens from a path) instead of making a link. The helper makes
                      a folder for this review in the cache ($JARED_CACHE, or $XDG_CACHE_HOME/jared, or ~/.cache/jared), puts the page
                      and a script, jared-boot.js, that gives the page the file, in it, opens the page with open or xdg-open, and
                      prints one sentence. The script is replaced after $JARED_BOOT_KEEP seconds (default 3600) by one that says that the review has expired, so that a page opened later can tell, and review folders
                      more than an hour old are removed the next time. The file may be as big as Jared opens.
  --page <path>       the one-file page (default: $JARED_PAGE; else app/jared.html in the plugin, which a published copy has;
                      else dist-single/jared.html of the repository that this plugin is in, which npm run build:single makes)

  --serve             make the review folder as --file does, make sure that the Jared service is running, and print the address
                      http://127.0.0.1:<port>/<secret>/<review folder>/jared.html on one line, for a browser tool to open. Give it 2 to 100 files, one after another, to review them together: each is read as UTF-8 text, no name may be given twice, and several files go with --serve only, not with --file, a link or --rev. The
                      service is one process that every review uses: it listens on 127.0.0.1 only, answers GET and HEAD for the
                      page and the script of a review folder, takes one POST for each review folder, at
                      /<secret>/<review folder>/message, which writes the review in that folder as the file review.json, and
                      nothing else, and ends by itself after $JARED_SERVICE_IDLE seconds (default 1800) without a request. Its port, secret, pid, the time of its start and the version of the plugin that started it are in the file "service" in the cache folder. A service that an earlier version of the plugin started, which an update leaves running, is stopped and replaced by one of this helper's version; a service of the same or a newer version is used as it is.
  --label <words>     the words on the button that hands the review to the caller (1 to 40 characters), so that the page has a
                      button and the caller can wait for the review with window.jared.waitForSubmit; for --serve only
  --closes, --message, --banner
                      what happens once the review is taken, as in the receiver; for --serve only
  --review-file       for --serve: the page sends the review to the service, which writes it as the file review.json of the review's folder
                      (see --wait), instead of keeping it for a script that drives the page: the page is given the address of its folder
                      in jared-boot.js, as window.__JARED_SERVICE, after the request
  --port <number>     the port for a service that has to be started (default: any free port); for --serve only
  --wait <review>     wait for the review that the page of a review made with --serve sends to the service, and print one line of JSON
                      and end with a status, as the receiver's wait does. <review> is the address that --serve printed, or the name of the
                      review's folder, or its path. The service writes each review that the page sends as the file review.json of the folder, whole,
                      with its revision (a whole number from 1) inside, or {"revision":<n>,"status":"cancelled"} or "skipped" when the reviewer
                      gave the review up or skipped it. The line is {"status":"received","revision":<n>,"reviewFile":<path>,"message":<words>}
                      (status 0), {"status":"cancelled",...} (4), {"status":"skipped",...} (5), {"status":"timeout",...} (3) or
                      {"status":"error","message":<words>} (1: the review's folder is not there or is gone, the service is not running or ended
                      while it waited, and the file holds nothing newer). A review that is in the file already is given at once. While it waits it
                      asks the service for its status now and then, which is a request that puts off the service's end.
  --after <revision>  for --wait: only a revision above this one counts (default 0): after taking revision 2, wait again with --after 2
  --timeout <seconds> for --wait: how long to wait (default 600; 1 to 3600)
  --check             open nothing, and say what Jared would take of the files given (their paths one after another), as one line of JSON. For each file, in the order given: its
                      name, its size in bytes and its status: ok; too-big (over --max; it is not read); empty (nothing, only spaces, or only a byte order mark); not-text (not UTF-8, or a NUL
                      byte in the first 8,000 characters); unreadable; or same-name (a path given twice: the later one). Then use, the names that can be opened, in order; fit, how many of the
                      first of them Jared takes in one review (at most 100 files, and --max bytes in all; it stops at the first that does not fit); bytes, their size; all, the size of every name in use;
                      stoppedBy, the limit that stopped the count (bytes, files, or null when all fit); and limit. Exit status 0 whenever the line is printed, 1 when the files could not be checked (nothing is printed), 2 for a mistake in the command line
  --stop              stop the Jared service, if one is running, and say so and how long it had run
  --status            say whether the Jared service is running, on which port, since when, which version of the plugin started it, and when it ends by itself; asking is a
                      request like any other, which puts the end off
  --version           say the version of the plugin that this helper belongs to

  --rev <commit>      write the change of one commit of the git repository that this folder is in to a file, which Jared shows as changes, and
                      print its path on one line; give that file to this helper or to Jared as any other. <commit> is whatever git takes for
                      one commit (a hash, an abbreviated hash, a tag, a branch, HEAD~2): a range is not one. The file is in the cache folder,
                      in diffs/, named for the first 12 characters of the hash. It holds one line, commit <hash>, an empty line, the message,
                      and the change as git show writes it: against the first parent for a merge, and against the empty tree for the first
                      commit. It has no author and no date, and none of your own git settings (colour, prefixes, an external diff, lines of
                      context) reaches it. Files in diffs/ more than an hour old are removed the next time. It takes no file and no option
                      but --max, and it changes nothing in the repository.

Exit status of --wait: 0 a review is in the file, 3 none came in time, 4 the reviewer gave the review up, 5 the reviewer skipped it, 1 an error, 2 a mistake in the command line.
Exit status of the others (--check: 0 whenever the line is printed, 1 when the files could not be checked, 2 a mistake in the command line): 0 done; 1 a file cannot be read, or, with --rev, the commit cannot be taken (the message says why); 2 a mistake in the command line (also a name given twice, and several files without --serve or with --rev); 3 too big (for a link, or for Jared: one file, or several together, or more than 100 files);
4 a file is not UTF-8 text; 5 --open or --file, and there is no way to open a browser here, or the page could not be opened;
6 --file or --serve, and the one-file page is not there; 7 --file, --serve or --rev, and a folder or a file for the review cannot be made;
8 --serve, and the service could not be started (the port is in use, or sockets cannot be opened).
USAGE
}

fail() {
  echo "jared-link: $1" >&2
  exit "$2"
}

file=
filelist=
nl='
'
jared=${JARED_URL:-http://localhost:5173/}
open=0
fileway=0
serve=0
stop=0
status=0
version=0
check=0
rev=
waitfor=
after=
timeout=
label=
closes=
message=
banner=
reviewfile=0
port=
page=${JARED_PAGE:-}
max=524288

while [ $# -gt 0 ]; do
  case $1 in
    --help | -h) usage; exit 0 ;;
    --open) open=1 ;;
    --file) fileway=1 ;;
    --serve) serve=1 ;;
    --review-file) reviewfile=1 ;;
    --stop) stop=1 ;;
    --status) status=1 ;;
    --version) version=1 ;;
    --check) check=1 ;;
    --rev)
      [ $# -ge 2 ] && [ -n "$2" ] || fail '--rev needs a commit.' 2
      rev=$2
      shift
      ;;
    --wait)
      [ $# -ge 2 ] && [ -n "$2" ] || fail '--wait needs a review: the address that --serve printed, or the name of its folder.' 2
      waitfor=$2
      shift
      ;;
    --after)
      [ $# -ge 2 ] && [ -n "$2" ] || fail '--after needs a revision, a whole number.' 2
      after=$2
      shift
      ;;
    --timeout)
      [ $# -ge 2 ] && [ -n "$2" ] || fail '--timeout needs a number of seconds.' 2
      timeout=$2
      shift
      ;;
    --label)
      [ $# -ge 2 ] && [ -n "$2" ] || fail '--label needs the words for the button.' 2
      # A plugin setting that was never set reaches the skill unfilled; a label that is still the setting's own name is no words, and the
      # way on is the setting's default (leaving the label out would leave the page with no button).
      case $2 in '${user_config.'*) fail "--label is still $2, which means that the plugin setting was never set. Use its default: --label \"Submit review\"." 2 ;; esac
      label=$2
      shift
      ;;
    --closes)
      [ $# -ge 2 ] && [ -n "$2" ] || fail '--closes needs moment, now or never.' 2
      closes=$2
      shift
      ;;
    --message)
      [ $# -ge 2 ] && [ -n "$2" ] || fail '--message needs the words that tell the reviewer that the review was sent.' 2
      message=$2
      shift
      ;;
    --banner)
      [ $# -ge 2 ] && [ -n "$2" ] || fail '--banner needs true or false.' 2
      banner=$2
      shift
      ;;
    --port)
      [ $# -ge 2 ] && [ -n "$2" ] || fail '--port needs a port number.' 2
      port=$2
      shift
      ;;
    --page)
      [ $# -ge 2 ] || fail '--page needs the path of the page.' 2
      page=$2
      shift
      ;;
    --jared)
      [ $# -ge 2 ] || fail '--jared needs an address.' 2
      jared=$2
      shift
      ;;
    --max)
      [ $# -ge 2 ] || fail '--max needs a number of bytes.' 2
      max=$2
      shift
      ;;
    --*) fail "Unknown option \"$1\"." 2 ;;
    *)
      case $1 in *[[:cntrl:]]*) fail 'A file name has a control character in it.' 2 ;; esac
      [ -n "$file" ] || file=$1
      filelist=$filelist$1$nl
      ;;
  esac
  shift
done
nfiles=$(printf '%s' "$filelist" | wc -l | tr -d ' ')

case $max in '' | *[!0-9]*) fail '--max must be a whole number of bytes.' 2 ;; esac
case $jared in http://* | https://*) ;; *) fail 'The address of Jared must be an http or https address.' 2 ;; esac
[ $((stop + status + version)) -le 1 ] || fail 'Give one of --stop, --status and --version, and not more.' 2
if [ "$check" = 1 ]; then
  { [ "$stop" = 0 ] && [ "$status" = 0 ] && [ "$version" = 0 ] && [ "$serve" = 0 ] && [ "$fileway" = 0 ] && [ "$open" = 0 ] && [ "$reviewfile" = 0 ] && [ -z "$waitfor$rev$label$closes$message$banner$port$page$after$timeout" ]; } \
    || fail '--check takes files and --max, and nothing else.' 2
  [ -n "$file" ] || fail '--check needs one or more files.' 2
fi
if [ "$stop" = 1 ]; then
  { [ "$serve" = 0 ] && [ "$fileway" = 0 ] && [ -z "$file" ]; } || fail '--stop takes nothing else.' 2
fi
if [ "$status" = 1 ]; then
  { [ "$serve" = 0 ] && [ "$fileway" = 0 ] && [ -z "$file" ]; } || fail '--status takes no file and no option.' 2
fi
if [ "$version" = 1 ]; then
  { [ "$serve" = 0 ] && [ "$fileway" = 0 ] && [ -z "$file" ]; } || fail '--version takes no file and no option.' 2
fi
{ [ "$serve" = 0 ] || [ "$fileway" = 0 ]; } || fail '--serve and --file are two ways: give one.' 2
{ [ "$nfiles" -le 1 ] || [ "$serve" = 1 ] || [ "$check" = 1 ]; } || fail 'Several files go with --serve only.' 2
if [ -n "$waitfor" ]; then
  { [ -z "$file" ] && [ "$serve" = 0 ] && [ "$fileway" = 0 ] && [ "$open" = 0 ] && [ "$stop" = 0 ] && [ "$status" = 0 ] && [ "$version" = 0 ] && [ -z "$rev$label$closes$message$banner$port" ]; } \
    || fail '--wait takes a review, --after and --timeout, and nothing else.' 2
  case $after in '' | *[!0-9]*) [ -z "$after" ] || fail '--after must be a whole number.' 2 ;; esac
  case $timeout in '' | *[!0-9]*) [ -z "$timeout" ] || fail '--timeout must be a whole number of seconds.' 2 ;; esac
  [ -z "$timeout" ] || { [ "$timeout" -ge 1 ] && [ "$timeout" -le 3600 ]; } || fail '--timeout must be from 1 to 3600 seconds.' 2
elif [ -n "$after$timeout" ]; then
  fail '--after and --timeout are for --wait.' 2
fi
if [ -n "$rev" ]; then
  # What the commit is called goes to git, which would take a word that begins with a hyphen for an option of its own.
  case $rev in -*) fail "A commit does not begin with a hyphen, and \"$rev\" does." 2 ;; esac
  { [ -z "$file" ] && [ "$serve" = 0 ] && [ "$fileway" = 0 ] && [ "$open" = 0 ] && [ "$stop" = 0 ] && [ "$status" = 0 ] && [ "$version" = 0 ] && [ -z "$label$closes$message$banner$port" ]; } || fail '--rev takes no file and no option but --max.' 2
fi
if [ "$serve" = 0 ] && { [ -n "$label$closes$message$banner$port" ] || [ "$reviewfile" = 1 ]; }; then
  fail '--label, --closes, --message, --banner, --review-file and --port are for --serve.' 2
fi
case $closes in '' | moment | now | never) ;; *) fail '--closes must be moment, now or never.' 2 ;; esac
case $banner in '' | true | false) ;; *) fail '--banner must be true or false.' 2 ;; esac
case $port in '' | *[!0-9]*) [ -z "$port" ] || fail '--port must be a whole number.' 2 ;; *) [ "$port" -le 65535 ] || fail '--port must be at most 65535.' 2 ;; esac

# The manifest of the plugin that this helper belongs to, and its version, which is what a service that this helper starts is told, or nothing when it
# cannot be read or has characters that no version has.
manifest=$(cd "$(dirname "$0")" && pwd)/../.claude-plugin/plugin.json
own_version() {
  number=$(perl -ne 'if (/"version"\s*:\s*"([^"]+)"/) { print $1; exit }' "$manifest" 2> /dev/null)
  case $number in *[!0-9A-Za-z._+-]*) number= ;; esac
  printf '%s' "$number"
}

# The folder for the reviews: $JARED_CACHE, or $XDG_CACHE_HOME/jared, or ~/.cache/jared. Sets base.
cache_base() {
  if [ -n "${JARED_CACHE:-}" ]; then
    base=$JARED_CACHE
  elif [ -n "${XDG_CACHE_HOME:-}" ]; then
    base=$XDG_CACHE_HOME/jared
  elif [ -n "${HOME:-}" ]; then
    base=$HOME/.cache/jared
  else
    fail 'There is no place for the review: set JARED_CACHE to a folder.' 7
  fi
}

# Whether the service that the file "service" tells of answers on its port with its own pid: service_alive <port> <secret> <pid>.
# A pid that a file names is never trusted by itself.
service_alive() {
  case $3 in '' | *[!0-9]* | 0*) return 1 ;; esac # a pid is a number that does not begin with 0: kill 0 is the whole process group
  perl -MIO::Socket::INET -e '
    my ($port, $token, $pid) = @ARGV;
    alarm 3;
    my $s = IO::Socket::INET->new(PeerAddr => "127.0.0.1", PeerPort => $port, Timeout => 2) or exit 1;
    print $s "GET /$token/health HTTP/1.1\r\nHost: 127.0.0.1:$port\r\nConnection: close\r\n\r\n";
    local $/;
    my $r = <$s>;
    exit(defined $r && $r =~ m{^HTTP/1\.1 200 [^\r]*\r\n.*\r\n\r\njared-service $pid\n}s ? 0 : 1);
  ' "$1" "$2" "$3" > /dev/null 2>&1
}

# Whether the file "service" tells of a service that answers: sets svc_port, svc_token, svc_pid, svc_started (the time of its start in
# seconds, or nothing for a file that an older helper wrote) and svc_version (the version of the plugin that started it, or nothing for a service
# of a version before this was written down).
service_running() {
  svc_port= svc_token= svc_pid= svc_started= svc_version=
  [ -f "$base/service" ] || return 1
  read -r svc_port svc_token svc_pid svc_started svc_version < "$base/service" 2> /dev/null
  service_alive "$svc_port" "$svc_token" "$svc_pid"
}

# Whether version $1 is older than version $2, which must be numbers with dots, as 1.2.3 is (a suffix such as -rc.1 is not looked at): 1.9.0 is older than
# 1.10.0. A service with no version written down ($1 empty) is older than any version. When $2 is nothing, or $1 is something that cannot be compared,
# nothing is older, so that a service is never replaced because of a version that this helper cannot read.
version_older() {
  [ -n "$2" ] || return 1
  [ -n "$1" ] || return 0
  perl -e 'my @a = $ARGV[0] =~ /^(\d+)\.(\d+)\.(\d+)/ or exit 1; my @b = $ARGV[1] =~ /^(\d+)\.(\d+)\.(\d+)/ or exit 1; for my $i (0 .. 2) { exit 0 if $a[$i] < $b[$i]; exit 1 if $a[$i] > $b[$i] } exit 1' "$1" "$2"
}

# Whether the service that answers is to be used as it is. It is not when an earlier version of the plugin started it: one with no version written
# down, or with a version older than this helper's own. One of the same version, of a newer one (a helper never goes back), or of a version that cannot
# be compared is used, and so is any when this helper cannot read its own version, as before the version was written down. So services are only ever
# replaced by newer ones: two sessions with two versions of the plugin do not take turns at ending each other's service.
service_current() {
  service_running || return 1
  version_older "$svc_version" "$ownver" && return 1
  return 0
}

# Ends the service that service_running found, and waits up to two seconds for its process to go.
end_service() {
  kill "$svc_pid" 2> /dev/null
  waited=0
  while kill -0 "$svc_pid" 2> /dev/null && [ "$waited" -lt 20 ]; do
    sleep 0.1
    waited=$((waited + 1))
  done
}

# Makes sure that the Jared service is running, and sets svc_port and svc_token: the one that the file "service" tells of when it
# answers, else a new one, started in the background, which writes the file and prints its port and secret. Reviews that begin at the
# same moment would each find no service and each start one, so one helper at a time looks and starts, under a lock that mkdir makes
# (it is atomic) in the cache folder. A lock more than a minute old was left by a helper that was killed, and is taken over. After ten
# seconds without it a helper looks once more and, when there is still no service, goes on without the lock, so that a review is never held up by it.
service_started() {
  ownver=$(own_version)
  service_current && return 0
  locked=0
  tries=0
  while [ "$tries" -lt 100 ]; do
    if mkdir "$base/service.lock" 2> /dev/null; then
      locked=1
      break
    fi
    if [ -n "$(find "$base/service.lock" -maxdepth 0 -mmin +1 2> /dev/null)" ]; then
      rmdir "$base/service.lock" 2> /dev/null
      continue
    fi
    tries=$((tries + 1))
    perl -e 'select(undef, undef, undef, 0.1)'
  done
  if service_current; then
    if [ "$locked" = 1 ]; then rmdir "$base/service.lock" 2> /dev/null; fi
    return 0
  fi
  # What answers now was started by an earlier version of the plugin, so it is ended and replaced, under the lock that makes one helper at a time do it.
  if service_running; then end_service; fi
  idle=${JARED_SERVICE_IDLE:-1800}
  case $idle in '' | *[!0-9]*) idle=1800 ;; esac
  started=$(perl - "$base" "$idle" "${port:-0}" "$ownver" <<'PERL'
    use strict;
    use warnings;
    use IO::Socket::INET;
    use IO::Select;
    use POSIX qw(setsid);
    use JSON::PP;
    use Fcntl qw(:flock);
    use B ();
    my ($base, $idle, $want, $version) = @ARGV;
    open(my $rnd, "<:raw", "/dev/urandom") or exit 8;
    (read($rnd, my $bytes, 16) // 0) == 16 or exit 8;
    close $rnd;
    my $token = unpack("H*", $bytes);
    my $srv = IO::Socket::INET->new(Listen => 20, LocalAddr => "127.0.0.1", LocalPort => $want, ReuseAddr => 1) or exit 8;
    my $port = $srv->sockport;
    my $state = "$base/service";
    my $daemon = 0;
    my $started = time;
    $version = "" unless defined $version;
    # What the file "service" holds, and what the service knows it by: its port, secret and pid, the time of its start, and the version of the plugin that started it.
    sub state_line { return "$port $token $daemon $started" . (length $version ? " $version" : "") . "\n" }
    my ($previous, $latest) = ($started, $started);
    pipe(my $ready_r, my $ready_w) or exit 8;
    my $pid = fork;
    defined $pid or exit 8;
    if ($pid) {
      close $ready_w;
      my $ok = <$ready_r>;
      defined $ok && $ok eq "ok\n" or exit 8;
      print "$port $token\n";
      exit 0;
    }
    close $ready_r;
    setsid();
    open(STDIN, "<", "/dev/null");
    open(STDOUT, ">", "/dev/null");
    open(STDERR, ">", "/dev/null");
    $daemon = $$;
    sub mine {
      open(my $f, "<", $state) or return 0;
      my $line = <$f>;
      return defined $line && $line eq state_line();
    }
    sub finish {
      unlink $state if mine();
      exit 0;
    }
    sub reply {
      my ($c, $code, $text, $type, $body, $head, $extra) = @_;
      my $out = "HTTP/1.1 $code $text\r\nContent-Type: $type\r\nContent-Length: " . length($body) . "\r\nCache-Control: no-store\r\nX-Content-Type-Options: nosniff\r\nReferrer-Policy: no-referrer\r\nConnection: close\r\n" . ($extra // "") . "\r\n";
      $out .= $body unless $head;
      my $off = 0;
      while ($off < length $out) {
        my $n = syswrite($c, $out, 65536, $off);
        defined $n or return;
        $off += $n;
      }
    }
    sub say_json {
      my ($c, $code, $text, $data) = @_;
      reply($c, $code, $text, "application/json; charset=utf-8", JSON::PP->new->utf8->canonical->encode($data) . "\n");
    }
    # What a review folder takes from its page: one POST, at /<secret>/<review folder>/message, of the receiver's own submit, cancelled or skipped.
    # It is written as the file review.json of that folder, whole, by a temporary file and a rename, with its revision inside; the answer says the revision that the file holds.
    sub take {
      my ($c, $sel, $target, $headers, $rest) = @_;
      my @h = @$headers;
      my ($origin) = map { /^origin:\s*(.*?)\s*$/i ? lc($1) : () } @h;
      if (defined $origin) {
        $origin eq "http://127.0.0.1:$port" || $origin eq "http://localhost:$port" or return reply($c, 403, "Forbidden", "text/plain", "Forbidden\n");
      }
      $target =~ m{^/$token/(review\.[A-Za-z0-9]{6})/message$} or return reply($c, 404, "Not Found", "text/plain", "Not found\n");
      my $folder = $1;
      my ($type) = map { /^content-type:\s*(.*?)\s*$/i ? lc($1) : () } @h;
      defined $type && $type =~ m{^application/json(?:\s*;\s*charset=utf-8)?$}
        or return say_json($c, 415, "Unsupported Media Type", { ok => JSON::PP::false, code => "type", message => "Send application/json." });
      my @lengths = map { /^content-length:\s*(.*?)\s*$/i ? $1 : () } @h;
      @lengths <= 1 or return say_json($c, 400, "Bad Request", { ok => JSON::PP::false, code => "invalid", message => "More than one Content-Length." });
      @lengths == 1 && $lengths[0] =~ /^[0-9]+$/ or return say_json($c, 411, "Length Required", { ok => JSON::PP::false, code => "length", message => "Send a Content-Length." });
      my $length = $lengths[0] + 0;
      $length <= 4194304 or return say_json($c, 413, "Payload Too Large", { ok => JSON::PP::false, code => "large", message => "Over 4 MB." });
      my $body = defined $rest ? $rest : "";
      while (length($body) < $length) {
        $sel->can_read(5) or return;
        sysread($c, my $chunk, 65536) or return;
        $body .= $chunk;
      }
      $body = substr($body, 0, $length);
      my $bad = sub { say_json($c, 400, "Bad Request", { ok => JSON::PP::false, code => "invalid", message => $_[0] }) };
      my $data = eval { JSON::PP->new->utf8->decode($body) };
      ref $data eq "HASH" or return $bad->("The message is not a JSON object.");
      defined $data->{protocol} && !ref $data->{protocol} && $data->{protocol} eq "1" or return $bad->("The protocol is not 1.");
      my $kind = $data->{type};
      defined $kind && !ref $kind && $kind =~ /^(?:submit|cancelled|skipped)$/ or return $bad->("The type is not submit, cancelled or skipped.");
      my ($revision, $review, $changes);
      if ($kind eq "submit") {
        $review = $data->{review};
        # Version 1 is a review of one file (a "file" with a name), version 2 of a set of 2 to 100 files (a "files" list of entries that each have a name).
        my $named = sub { ref $_[0] eq "HASH" && defined $_[0]{name} && !ref $_[0]{name} };
        ref $review eq "HASH" && defined $review->{version} && !ref $review->{version} && ref $review->{comments} eq "ARRAY"
          && (($review->{version} eq "1" && $named->($review->{file}))
            || ($review->{version} eq "2" && ref $review->{files} eq "ARRAY" && @{$review->{files}} >= 2 && @{$review->{files}} <= 100 && !grep { !$named->($_) } @{$review->{files}}))
          or return $bad->("The review is not a review of version 1 or 2.");
        # The file says that a review has ended by a top-level status, so a review that has one of its own would end the review.
        exists $review->{status} and return $bad->("The review has a status.");
        # What the page says differs from the review that was taken before it: the ids of comments, a help and never the truth. It is kept beside the revision.
        if (exists $data->{changes}) {
          my $n = $data->{changes};
          # An id is a string: a number that JSON::PP read is flagged as one, and a string of the same digits is not.
          my $ids = sub { ref $_[0] eq "ARRAY" && !grep { my $f = defined $_ && !ref $_ ? B::svref_2object(\$_)->FLAGS : 0; !($f & B::SVp_POK) || ($f & (B::SVp_IOK | B::SVp_NOK)) || length($_) > 200 } @{$_[0]} };
          ref $n eq "HASH" && defined $n->{since} && !ref $n->{since} && $n->{since} =~ /^[0-9]{1,9}$/ && $ids->($n->{new}) && $ids->($n->{edited}) && $ids->($n->{deleted})
            or return $bad->("The changes are not a revision and lists of the ids of comments.");
          $changes = { since => $n->{since} + 0, new => [map { "$_" } @{$n->{new}}], edited => [map { "$_" } @{$n->{edited}}], deleted => [map { "$_" } @{$n->{deleted}}] };
        }
        if (exists $data->{revision}) {
          my $r = $data->{revision};
          defined $r && !ref $r && $r =~ /^[1-9][0-9]{0,8}$/ or return $bad->("The revision is not a whole number from 1.");
          $revision = $r + 0;
        }
      }
      my $dir = "$base/$folder";
      -d $dir && !-l $dir && -f "$dir/jared.html" && !-l "$dir/jared.html" or return reply($c, 404, "Not Found", "text/plain", "Not found\n");
      umask 077;
      my $failed = sub { say_json($c, 500, "Internal Server Error", { ok => JSON::PP::false, code => "write", message => "The review could not be written." }) };
      open(my $lock, ">>", "$dir/review.lock") or return $failed->();
      flock($lock, LOCK_EX) or return $failed->();
      my $file = "$dir/review.json";
      my ($have, $state, $text) = (0, undef, undef);
      if (-f $file && !-l $file && open(my $in, "<:raw", $file)) {
        local $/;
        $text = <$in>;
        close $in;
        my $old = eval { JSON::PP->new->utf8->decode($text) };
        if (ref $old eq "HASH") {
          $have = $old->{revision} // 0;
          $state = $old->{status};
        }
      }
      defined $state and return say_json($c, 409, "Conflict", { ok => JSON::PP::false, code => "closed", message => "The review has ended.", revision => $have + 0 });
      my $json = JSON::PP->new->utf8->canonical;
      my ($new, $out);
      if ($kind eq "submit") {
        $new = defined $revision ? $revision : $have + 1;
        my %file = %$review;
        delete $file{changes}; # a field of the review's own with that name is not the note
        $file{changes} = $changes if defined $changes;
        $file{revision} = $new + 0;
        $out = $json->encode(\%file) . "\n";
        my $same = defined $text && $text eq $out;
        $new < $have || ($new == $have && !$same)
          and return say_json($c, 409, "Conflict", { ok => JSON::PP::false, code => "stale", message => "The file holds a later revision.", revision => $have + 0 });
        return say_json($c, 200, "OK", { ok => JSON::PP::true, revision => $new + 0 }) if $same;
      } else {
        $new = $have + 1;
        $out = $json->encode({ revision => $new + 0, status => $kind }) . "\n";
      }
      my $tmp = "$dir/.review.json.$$";
      open(my $o, ">", $tmp) or return $failed->();
      binmode $o;
      print $o $out;
      close($o) or do { unlink $tmp; return $failed->() };
      rename($tmp, $file) or do { unlink $tmp; return $failed->() };
      say_json($c, 200, "OK", { ok => JSON::PP::true, revision => $new + 0 });
    }
    sub answer {
      my $c = shift;
      my $sel = IO::Select->new($c);
      my $buf = "";
      until ($buf =~ /\r\n\r\n/) {
        length($buf) < 8192 or return reply($c, 431, "Request Header Fields Too Large", "text/plain", "Too large\n");
        $sel->can_read(5) or return;
        sysread($c, my $chunk, 4096) or return;
        $buf .= $chunk;
      }
      my ($top, $rest) = split /\r\n\r\n/, $buf, 2;
      my ($line, @headers) = split /\r\n/, $top;
      defined $line && $line =~ m{^([A-Z]+) (\S+) HTTP/1\.[01]$} or return reply($c, 400, "Bad Request", "text/plain", "Bad request\n");
      my ($method, $target) = ($1, $2);
      $method eq "GET" || $method eq "HEAD" || $method eq "POST" or return reply($c, 405, "Method Not Allowed", "text/plain", "Method not allowed\n", 0, "Allow: GET, HEAD, POST\r\n");
      my ($host) = map { /^host:\s*(.*?)\s*$/i ? lc($1) : () } @headers;
      defined $host && ($host eq "127.0.0.1:$port" || $host eq "localhost:$port") or return reply($c, 403, "Forbidden", "text/plain", "Forbidden\n");
      return take($c, $sel, $target, \@headers, $rest) if $method eq "POST";
      my $head = $method eq "HEAD";
      return reply($c, 200, "OK", "text/plain; charset=utf-8", "jared-service $daemon\n", $head) if $target eq "/$token/health";
      return reply($c, 200, "OK", "application/json; charset=utf-8", "{\"pid\":$daemon,\"started\":$started,\"now\":" . time . ",\"previous\":$previous,\"idle\":$idle" . (length $version ? ",\"version\":\"$version\"" : "") . "}\n", $head) if $target eq "/$token/status";
      if ($target =~ m{^/$token/(review\.[A-Za-z0-9]{6})/(jared\.html|jared-boot\.js)$}) {
        my ($folder, $name) = ($1, $2);
        my $path = "$base/$folder/$name";
        my $type = $name eq "jared.html" ? "text/html; charset=utf-8" : "text/javascript; charset=utf-8";
        if (-f $path && !-l $path && open(my $f, "<:raw", $path)) {
          local $/;
          my $body = <$f>;
          close $f;
          return reply($c, 200, "OK", $type, $body, $head);
        }
      }
      reply($c, 404, "Not Found", "text/plain", "Not found\n", $head);
    }
    {
      my $tmp = "$state.$$";
      open(my $o, ">", $tmp) or exit 8;
      print $o state_line();
      close($o) or exit 8;
      rename($tmp, $state) or exit 8;
    }
    print $ready_w "ok\n";
    close $ready_w;
    $SIG{TERM} = \&finish;
    $SIG{INT} = \&finish;
    $SIG{ALRM} = \&finish;
    $SIG{CHLD} = "IGNORE";
    alarm $idle;
    while (my $c = $srv->accept) {
      alarm $idle;
      ($previous, $latest) = ($latest, time);
      my $kid = fork;
      if (defined $kid && $kid == 0) {
        close $srv;
        $SIG{TERM} = "DEFAULT";
        $SIG{ALRM} = "DEFAULT";
        alarm 10;
        answer($c);
        exit 0;
      }
      close $c;
    }
PERL
  )
  code=$?
  if [ "$locked" = 1 ]; then rmdir "$base/service.lock" 2> /dev/null; fi
  [ "$code" = 0 ] || return 1
  read -r svc_port svc_token <<EOF
$started
EOF
}

# A length of time in words, for --stop and --status: "20 seconds", "1 minute", "27 minutes", "1 hour and 5 minutes". Needs perl, as the service does.
SPAN_PERL='sub span {
  my $s = int(shift);
  return "$s second" . ($s == 1 ? "" : "s") if $s < 60;
  my $m = int($s / 60);
  return "$m minute" . ($m == 1 ? "" : "s") if $m < 60;
  my $h = int($m / 60);
  $m %= 60;
  my $t = "$h hour" . ($h == 1 ? "" : "s");
  $t .= " and $m minute" . ($m == 1 ? "" : "s") if $m;
  return $t;
}'

if [ "$stop" = 1 ]; then
  cache_base
  service_running || true
  if service_alive "$svc_port" "$svc_token" "$svc_pid"; then
    ran=
    case $svc_started in
      '' | *[!0-9]*) ;;
      *) ran=$(perl -e "$SPAN_PERL"' print span(time - $ARGV[0]);' "$svc_started" 2> /dev/null) ;;
    esac
    end_service
    if [ -n "$ran" ]; then echo "Stopped the Jared service, which had run for $ran."; else echo 'Stopped the Jared service.'; fi
  else
    rm -f "$base/service"
    echo 'No Jared service is running.'
  fi
  exit 0
fi

if [ "$status" = 1 ]; then
  cache_base
  svc_port= svc_token= svc_pid= svc_started= svc_version=
  [ -f "$base/service" ] && read -r svc_port svc_token svc_pid svc_started svc_version < "$base/service" 2> /dev/null
  # The service is asked for its status and for nothing before it, so that the request before this one that it reports is not the helper's own.
  { printf '%s\n' "$SPAN_PERL"; cat <<'PERL'
      use strict;
      use warnings;
      use IO::Socket::INET;
      use JSON::PP;
      use POSIX qw(strftime);
      my ($port, $token, $pid) = @ARGV;
      sub ask {
        my $path = shift;
        my $s = IO::Socket::INET->new(PeerAddr => "127.0.0.1", PeerPort => $port, Timeout => 2) or return undef;
        print $s "GET /$token/$path HTTP/1.1\r\nHost: 127.0.0.1:$port\r\nConnection: close\r\n\r\n";
        local $/;
        my $r = <$s>;
        return defined $r && $r =~ m{^HTTP/1\.1 200 [^\r]*\r\n.*?\r\n\r\n(.*)$}s ? $1 : undef;
      }
      alarm 5;
      my $none = 0;
      $none = 1 unless defined $port && $port =~ /^\d+\z/ && defined $token && $token =~ /^[0-9a-f]+\z/ && defined $pid && $pid =~ /^[1-9][0-9]*\z/;
      if (!$none) {
        my $body = ask("status");
        my $data = defined $body ? eval { decode_json($body) } : undef;
        if (ref $data eq "HASH" && defined $data->{pid} && $data->{pid} eq $pid && defined $data->{started} && defined $data->{now} && defined $data->{previous} && defined $data->{idle}) {
          print "The Jared service is running, on port $port (process $pid).\n";
          print "It started at " . strftime("%H:%M", localtime($data->{started})) . ", " . span($data->{now} - $data->{started}) . " ago.\n";
          print "The request before this one came " . span($data->{now} - $data->{previous}) . " ago. This one puts the end off: it ends by itself in " . span($data->{idle}) . " if no other request comes.\n";
          print "It is of version $data->{version}.\n" if defined $data->{version} && $data->{version} =~ /^[0-9A-Za-z._+-]+\z/;
          exit 0;
        }
        my $health = ask("health");
        if (defined $health && $health eq "jared-service $pid\n") {
          print "The Jared service is running, on port $port (process $pid). It is of an older version, and cannot say since when, or when it ends.\n";
          exit 0;
        }
      }
      print "No Jared service is running.\n";
PERL
  } | perl - "$svc_port" "$svc_token" "$svc_pid"
  exit 0
fi

if [ "$version" = 1 ]; then
  number=$(own_version)
  [ -n "$number" ] || fail "The version of this plugin cannot be read: $manifest is missing, or has no version." 1
  echo "Jared plugin $number"
  exit 0
fi

# --wait: the file review.json of a review folder, which the service writes, until it holds a revision above --after.
if [ -n "$waitfor" ]; then
  cache_base
  name=$(perl -e 'print $1 if $ARGV[0] =~ m{(?:^|/)(review\.[A-Za-z0-9]{6})(?:/|$)}' "$waitfor")
  perl - "$base" "$name" "${after:-0}" "${timeout:-600}" <<'PERL'
    use strict;
    use warnings;
    use JSON::PP;
    use IO::Socket::INET;
    use Time::HiRes qw(time);
    my ($base, $name, $after, $timeout) = @ARGV;
    my $json = JSON::PP->new->utf8->canonical;
    sub finish {
      my ($status, $code, %more) = @_;
      print $json->encode({ status => $status, %more }), "\n";
      exit $code;
    }
    $name ne "" or finish("error", 1, message => "That is not a review: give the address that --serve printed, or the name of its folder.");
    my $dir = "$base/$name";
    -d $dir && !-l $dir or finish("error", 1, message => "There is no folder for that review.");
    my $file = "$dir/review.json";
    my $deadline = time + $timeout;
    # What the service says of itself, and so a request that puts off its end: its idle time in seconds, or undef when it does not answer.
    sub ask_service {
      open(my $f, "<", "$base/service") or return undef;
      my ($port, $token) = split " ", (scalar <$f> // "");
      close $f;
      defined $port && defined $token && $port =~ /^[0-9]+$/ && $token =~ /^[0-9a-f]{32}$/ or return undef;
      # A service that takes the connection and does not answer is no service: after 4 seconds the alarm ends the asking, with an answer of none, and not the helper.
      my $answer = eval {
        local $SIG{ALRM} = sub { die "alarm\n" };
        alarm 4;
        my $s = IO::Socket::INET->new(PeerAddr => "127.0.0.1", PeerPort => $port, Timeout => 3) or die "no service\n";
        print $s "GET /$token/status HTTP/1.1\r\nHost: 127.0.0.1:$port\r\nConnection: close\r\n\r\n";
        local $/;
        scalar <$s>;
      };
      alarm 0;
      defined $answer && $answer =~ m{^HTTP/1\.1 200 .*?\r\n\r\n(\{.*\})}s or return undef;
      my $state = eval { JSON::PP->new->decode($1) };
      return ref $state eq "HASH" && defined $state->{idle} && $state->{idle} =~ /^[0-9]+$/ ? $state->{idle} + 0 : undef;
    }
    my $every = 5;
    my $next = 0;
    while (1) {
      if (-f $file && !-l $file && open(my $in, "<:raw", $file)) {
        local $/;
        my $text = <$in>;
        close $in;
        my $data = eval { JSON::PP->new->utf8->decode($text) };
        if (ref $data eq "HASH" && defined $data->{revision} && !ref $data->{revision} && $data->{revision} =~ /^[0-9]+$/ && $data->{revision} > $after) {
          my $n = $data->{revision} + 0;
          my $state = $data->{status} // "";
          finish("cancelled", 4, revision => $n, message => "The reviewer gave the review up.") if $state eq "cancelled";
          finish("skipped", 5, revision => $n, message => "The reviewer skipped the review.") if $state eq "skipped";
          finish("received", 0, revision => $n, reviewFile => $file, message => "Revision $n of this review is in the file. Read it; to take a later one, wait again with --after $n.");
        }
      }
      -d $dir or finish("error", 1, message => "The folder of the review is gone.");
      if (time >= $next) {
        my $idle = ask_service();
        defined $idle or finish("error", 1, message => "The Jared service is not running, so no review can come.");
        $every = $idle / 3 < 1 ? 1 : $idle / 3 > 30 ? 30 : int($idle / 3);
        $next = time + $every;
      }
      time >= $deadline and finish("timeout", 3, message => "No review came in $timeout seconds.");
      select(undef, undef, undef, 0.25);
    }
PERL
  exit $?
fi

if [ -n "$rev" ]; then
  command -v git > /dev/null 2>&1 || fail 'git is not installed here, and a commit needs it.' 1
  git rev-parse --git-dir > /dev/null 2>&1 || fail 'This folder is not in a git repository, so there is no commit to take.' 1
  # One commit: a range or a name of something else does not pass, and what passes is the full hash, which is all that goes to git below.
  hash=$(git rev-parse --verify --quiet "$rev^{commit}" 2> /dev/null) || fail "\"$rev\" is not one commit in this repository." 1

  cache_base
  umask 077
  mkdir -p "$base/diffs" 2> /dev/null || fail "The cache folder \"$base\" cannot be made. Set JARED_CACHE to another folder." 7
  find "$base/diffs" -maxdepth 1 -name '*.diff' -mmin +60 2> /dev/null | while IFS= read -r old; do
    rm -f "$old"
  done
  tmp=$(mktemp "$base/diffs/.rev.XXXXXX" 2> /dev/null) || fail "A file for the commit cannot be made in \"$base/diffs\"." 7
  # The text as git writes it for anyone, whatever the settings of the user or of the repository: the options say what a setting might change.
  git show --format='commit %H%n%n%B' -m --first-parent --no-color --no-textconv \
    --find-renames -U3 --src-prefix=a/ --dst-prefix=b/ "$hash" > "$tmp" 2> /dev/null || {
    rm -f "$tmp"
    fail "git could not show \"$rev\"." 1
  }
  size=$(wc -c < "$tmp" | tr -d ' ')
  [ "$size" -le "$max" ] || {
    rm -f "$tmp"
    fail "The change of \"$rev\" is $size bytes, and $max is the most that Jared opens." 3
  }
  out=$base/diffs/$(printf '%s' "$hash" | cut -c1-12).diff
  mv -f "$tmp" "$out" 2> /dev/null || {
    rm -f "$tmp"
    fail "A file for the commit cannot be made in \"$base/diffs\"." 7
  }
  printf '%s\n' "$out"
  exit 0
fi

# --check: what Jared would take of these files, as one line of JSON, and nothing opened: the size and the status of each, in the order given, the names that
# can be opened, and how many of the first of them fit in one review (at most 100 files and $max bytes in all).
if [ "$check" = 1 ]; then
  set -f
  IFS=$nl
  set -- $filelist
  unset IFS
  set +f
  perl -MJSON::PP -e '
    my ($max, @paths) = @ARGV;
    my (%seen, @files, @use);
    for my $path (@paths) {
      next if $path eq "";
      my $name = $path;
      utf8::decode($name);
      my ($size, $status) = (0, "ok");
      if ($seen{$path}++) {
        $size = -s $path // 0;
        $status = "same-name";
      } elsif (!(-f $path && -r _)) {
        $status = "unreadable";
      } else {
        $size = -s _;
        if ($size > $max) {
          $status = "too-big";
        } elsif (!open(my $in, "<:raw", $path)) {
          $status = "unreadable";
        } else {
          local $/;
          my $text = <$in>;
          close $in;
          if (!defined $text || !utf8::decode($text) || substr($text, 0, 8000) =~ /\0/) { $status = "not-text" }
          elsif ($text =~ /\A[\s\x{FEFF}]*\z/) { $status = "empty" }
        }
      }
      push @files, { name => $name, size => $size + 0, status => $status };
      push @use, { name => $name, size => $size } if $status eq "ok";
    }
    my ($fit, $bytes, $all, $stopped) = (0, 0, 0, undef);
    $all += $_->{size} for @use;
    for my $u (@use) {
      if ($fit >= 100) { $stopped = "files"; last }
      if ($bytes + $u->{size} > $max) { $stopped = "bytes"; last }
      $fit++;
      $bytes += $u->{size};
    }
    print JSON::PP->new->ascii->canonical->encode({ files => \@files, use => [map { $_->{name} } @use], fit => $fit + 0, bytes => $bytes + 0, all => $all + 0, stoppedBy => $stopped, limit => { files => 100, bytes => $max + 0 } }), "\n";
  ' "$max" "$@" || fail 'The files could not be checked.' 1
  exit 0
fi

[ -n "$file" ] || { usage >&2; exit 2; }

if [ "$nfiles" -gt 1 ]; then
  # A set: 2 to 100 files, none more than $max bytes and all together not more than $max, which is what Jared opens for one review. A name given twice
  # is refused, and so is the first file that goes over a limit, by its name.
  [ "$nfiles" -le 100 ] || fail "$nfiles files are more than the 100 that Jared opens in one review." 3
  seen=$nl
  total=0
  while IFS= read -r one; do
    [ -n "$one" ] || continue
    [ -f "$one" ] && [ -r "$one" ] || fail "\"$one\" is not a file that can be read." 1
    case $seen in *"$nl$one$nl"*) fail "\"$one\" is given twice." 2 ;; esac
    seen=$seen$one$nl
    one_size=$(wc -c < "$one" | tr -d ' ')
    [ "$one_size" -le "$max" ] || fail "\"$one\" is $one_size bytes, and $max is the most that Jared opens." 3
    total=$((total + one_size))
    [ "$total" -le "$max" ] || fail "With \"$one\" the files are $total bytes, and $max is the most that Jared opens in one review." 3
  done <<LIST
$filelist
LIST
else
  [ -f "$file" ] && [ -r "$file" ] || fail "\"$file\" is not a file that can be read." 1

  size=$(wc -c < "$file" | tr -d ' ')
  if [ "$fileway" = 1 ] || [ "$serve" = 1 ]; then
    [ "$size" -le "$max" ] || fail "\"$file\" is $size bytes, and $max is the most that Jared opens." 3
  else
    [ "$size" -le "$max" ] || fail "\"$file\" is $size bytes, and $max is the most for a link." 3
  fi
fi

name=$(basename "$file")
now=$(date -u +%Y-%m-%dT%H:%M:%S.000Z)

if [ "$fileway" = 1 ] || [ "$serve" = 1 ]; then
  if [ "$serve" = 1 ]; then
    opener=
  elif command -v open > /dev/null 2>&1; then
    opener=open
  elif command -v xdg-open > /dev/null 2>&1; then
    opener=xdg-open
  else
    fail 'There is no way to open a browser here (open or xdg-open).' 5
  fi

  if [ -z "$page" ]; then
    here=$(cd "$(dirname "$0")" 2> /dev/null && pwd)
    # A published copy of the plugin carries the page, at app/jared.html; in the repository it is the one that npm run build:single made.
    page=$here/../app/jared.html
    [ -f "$page" ] || page=$here/../../dist-single/jared.html
  fi
  { [ -f "$page" ] && [ -r "$page" ]; } || fail "The one-file page is not at \"$page\". Reinstall the plugin, or, in the Jared source, build it with npm run build:single, or give --page <path>." 6

  cache_base
  umask 077
  mkdir -p "$base" 2> /dev/null || fail "The cache folder \"$base\" cannot be made. Set JARED_CACHE to another folder." 7
  # Folders of earlier reviews, left for more than an hour, are removed, and only a folder that holds a page of ours.
  find "$base" -maxdepth 1 -name 'review.*' -mmin +60 2> /dev/null | while IFS= read -r old; do
    [ -f "$old/jared.html" ] && rm -rf "$old"
  done
  dir=$(mktemp -d "$base/review.XXXXXX" 2> /dev/null) || fail "A folder for the review cannot be made in \"$base\"." 7
  # A hard link, so that a review costs no copy of the page; a copy where a link cannot be made (another volume).
  if ! { ln "$page" "$dir/jared.html" 2> /dev/null || cp "$page" "$dir/jared.html" 2> /dev/null; }; then
    rm -rf "$dir"
    fail "The page cannot be copied into \"$dir\"." 7
  fi

  # The request, as the script that sets window.__JARED_BOOT: perl does the JSON, in ASCII, so that no byte of the file is for the browser to decode.
  # With --serve the request also has the button's words and what happens when the review is taken (empty words are left out).
  # One file is the request's name and text; several are its files, each with its name as it was given, and a file that is not text is named on stdout.
  set -f
  IFS=$nl
  set -- $filelist
  unset IFS
  set +f
  bad=$(perl -MJSON::PP -e '
    my ($now, $out, $label, $closes, $message, $banner, $name, @files) = @ARGV;
    my $read = sub {
      my ($path) = @_;
      open(my $in, "<:raw", $path) or exit 1;
      local $/;
      my $text = <$in>;
      utf8::decode($text) or do { print $path; exit 4 };
      return $text;
    };
    my $request = { protocol => 1, id => "boot1", type => "open", review => undef, now => $now, submitTarget => "Claude" };
    if (@files > 1) {
      $request->{files} = [map { my $path = $_; utf8::decode($path); +{ name => $path, text => $read->($_) } } @files];
    } else {
      $request->{name} = $name;
      $request->{text} = $read->($files[0]);
    }
    # The words as the page takes them (src/engine/protocol.ts, words): trimmed, something that can be seen in them, no control or
    # invisible characters but a joiner and a non-joiner, at most $max characters, and (here) not starting with two hyphens.
    my $clean = sub {
      my ($words, $max) = @_;
      utf8::decode($words);
      $words =~ s/^\s+|\s+$//g;
      return undef if length($words) > $max || $words !~ /[^\s\p{Cf}]/ || $words =~ /^--/;
      (my $shown = $words) =~ s/[\x{200c}\x{200d}]//g;
      return undef if $shown =~ /[\p{Cc}\p{Cs}\p{Zl}\p{Zp}\p{Cf}]/;
      return $words;
    };
    if (length $label) {
      $request->{submitLabel} = $clean->($label, 40) // exit 9;
    }
    my %options;
    $options{closes} = $closes if length $closes;
    if (length $message) {
      $options{message} = $clean->($message, 80) // exit 10;
    }
    $options{banner} = $banner eq "true" ? JSON::PP::true : JSON::PP::false if length $banner;
    $request->{submitOptions} = \%options if %options;
    my $json = JSON::PP->new->ascii->canonical->encode([$request]);
    open(my $o, ">", $out) or exit 7;
    print $o "window.__JARED_BOOT = $json\n";
    close($o) or exit 7;
  ' "$now" "$dir/jared-boot.js" "$label" "$closes" "$message" "$banner" "$name" "$@") || {
    status=$?
    rm -rf "$dir"
    case $status in
      4) fail "\"${bad:-$file}\" is not text in UTF-8." 4 ;;
      7) fail "The script for the review cannot be written in \"$dir\"." 7 ;;
      9) fail '--label must be 1 to 40 characters, with no control or invisible characters, and must not start with two hyphens.' 2 ;;
      10) fail '--message must be 1 to 80 characters, with no control or invisible characters, and must not start with two hyphens.' 2 ;;
      *) fail "\"$file\" could not be turned into a request (status $status)." 1 ;;
    esac
  }

  keep=${JARED_BOOT_KEEP:-3600}
  case $keep in *[!0-9]*) keep=3600 ;; esac

  if [ "$serve" = 1 ]; then
    service_started || {
      rm -rf "$dir"
      fail 'The Jared service could not be started (the port is in use, or sockets cannot be opened).' 8
    }
    # The address of the folder, for the page to send the review to: only characters of a port, a secret and the name of a folder that this helper made.
    if [ "$reviewfile" = 1 ]; then
      printf 'window.__JARED_SERVICE = "http://127.0.0.1:%s/%s/%s"\n' "$svc_port" "$svc_token" "$(basename "$dir")" >> "$dir/jared-boot.js" \
        || { rm -rf "$dir"; fail "The script for the review cannot be written in \"$dir\"." 7; }
    fi
    (
      sleep "$keep"
      printf '%s\n' 'window.__JARED_BOOT_EXPIRED = true' > "$dir/jared-boot.js"
    ) > /dev/null 2>&1 < /dev/null &
    echo "http://127.0.0.1:$svc_port/$svc_token/$(basename "$dir")/jared.html"
    exit 0
  fi

  "$opener" "$dir/jared.html" || {
    rm -rf "$dir"
    fail "The page could not be opened with $opener." 5
  }
  # The page has read the script by then, unless its tab was slow to load, and the file need not stay in the cache.
  (
    sleep "$keep"
    printf '%s\n' 'window.__JARED_BOOT_EXPIRED = true' > "$dir/jared-boot.js"
  ) > /dev/null 2>&1 < /dev/null &
  echo "Opened $name in Jared from $dir/jared.html."
  exit 0
fi

# The whole request, as JSON, as base64url: perl does the JSON, which sh cannot do for any text.
link=$(perl -MJSON::PP -MMIME::Base64 -e '
  my ($file, $name, $now, $base) = @ARGV;
  open(my $in, "<:raw", $file) or exit 1;
  local $/;
  my $text = <$in>;
  utf8::decode($text) or exit 4;
  my $json = JSON::PP->new->utf8->canonical->encode({ protocol => 1, id => "link1", type => "open", name => $name, text => $text, review => undef, now => $now, submitTarget => "Claude" });
  my $value = encode_base64($json, "");
  $value =~ tr{+/}{-_};
  $value =~ s/=+$//;
  exit 3 if length($value) > 1000000;
  $base =~ s/#.*//s;
  print "$base#jared=$value";
' "$file" "$name" "$now" "$jared") || {
  status=$?
  case $status in
    4) fail "\"$file\" is not text in UTF-8." 4 ;;
    3) fail "\"$file\" is too big for a link once it is written out." 3 ;;
    *) fail "\"$file\" could not be turned into a link (status $status)." 1 ;;
  esac
}

if [ "$open" = 0 ]; then
  printf '%s\n' "$link"
  exit 0
fi

# Opening goes through the command line, which takes a link of some length only: a single argument may be 128 KB.
[ "${#link}" -le 100000 ] || fail "The link is ${#link} characters, too long to open from the command line. Print it instead, or use the receiver." 3
if command -v open > /dev/null 2>&1; then
  opener=open
elif command -v xdg-open > /dev/null 2>&1; then
  opener=xdg-open
else
  fail 'There is no way to open a browser here (open or xdg-open). Print the link instead.' 5
fi
"$opener" "$link" || fail "$opener could not open the link." 5
echo "Opened $name in Jared at ${jared%%\#*}."
